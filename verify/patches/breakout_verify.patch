+static int blocks_alive_count(void) {
+    int n = 0;
+    for (int r = 0; r < BLOCK_ROWS; r++) {
+        for (int c = 0; c < BLOCK_COLS; c++) {
+            if (block_alive[r][c]) n++;
+        }
+    }
+    return n;
+}
